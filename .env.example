# Copy to .env and add an OpenAI API key. Never commit .env.
MODEL_API_KEY=
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Number of prior question/answer turns supplied as conversation context.
MEMORY_TURNS=3
AUTO_INGEST=true
# extractive displays retrieved passages without calling the chat model.
# OpenAI embeddings still require the key when building/querying the index.
CHAT_MODE=llm
